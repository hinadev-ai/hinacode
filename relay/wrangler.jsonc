{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hinacode-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "routes": [{ "pattern": "relay.hinacode.app", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hinacode-relay",
      "database_id": "56f446fb-8323-4671-9008-ef8a05acdac3",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "e71bb8465534552f8ddc37c7962f98ae",
    "TUNNEL_ZONE_ID": "ef8f9d3e89546eb63bfda9d19191f642",
    "TUNNEL_ZONE_NAME": "hinacode.app",
    // iOS universal links. `<Team ID>.com.hinadev.hinacode`; the Team ID is on developer.apple.com > Membership.
    // Empty serves no apple-app-site-association.
    "APPLE_APP_ID": "",
    // Android App Links. The `android.package` in apps/mobile/app.json.
    "ANDROID_PACKAGE": "com.hinadev.hinacode",
    // The release signing certificate's SHA-256 as colon-separated hex, comma between several.
    // Play Console > App integrity > App signing key certificate, or `keytool -list -v -keystore <release keystore>`.
    // Empty serves no assetlinks.json.
    "ANDROID_CERT_SHA256": "",
  },
  "secrets": { "required": ["CLOUDFLARE_API_TOKEN", "OWNER_TOKEN"] },
}
