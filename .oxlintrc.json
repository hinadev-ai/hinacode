{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-perf", "jsx-a11y", "import", "unicorn"],
  "jsPlugins": [
    {
      "name": "react-doctor",
      "specifier": "oxlint-plugin-react-doctor"
    },
    {
      "name": "hinacode",
      "specifier": "oxlint-plugin-hinacode"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "typescript/no-explicit-any": "error",
    "hinacode/no-comments": "error",
    "no-underscore-dangle": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "hinacode/allergic-to-sparkling-icon": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          { "name": "lucide", "message": "No Lucide icons. Use react-icons/ri (Remix)." },
          { "name": "react-icons/lu", "message": "No Lucide icons. Use react-icons/ri (Remix)." }
        ],
        "patterns": [
          { "group": ["@lucide/*", "lucide-*"], "message": "No Lucide icons. Use react-icons/ri (Remix)." },
          {
            "group": ["@remixicon/*"],
            "message": "Use the HinaCode icons in src/renderer/components/icons, or react-icons/ri."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/renderer/**"],
      "rules": {
        "react/refs": "error",
        "react/purity": "error",
        "react/immutability": "error",
        "react/set-state-in-effect": "error",
        "react/set-state-in-render": "error",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/void-use-memo": "error",
        "react/preserve-manual-memoization": "error",
        "react/incompatible-library": "error",
        "react/globals": "error",
        "react/unsupported-syntax": "error",
        "react/error-boundaries": "error",
        "react/hooks": "error",
        "react/exhaustive-effect-dependencies": "error",
        "react-doctor/no-async-effect-callback": "error",
        "react-doctor/effect-listener-cleanup-mismatch": "error",
        "react-doctor/effect-observer-needs-disconnect": "error",
        "react-doctor/effect-raf-loop-needs-cancel": "error",
        "react-doctor/no-derived-state": "error",
        "react-doctor/no-derived-state-effect": "error",
        "react-doctor/no-did-mount-set-state": "error",
        "react-doctor/no-cascading-set-state": "error",
        "react-doctor/no-direct-mutation-state": "error",
        "react-doctor/no-controlled-input-value-without-state-update": "error",
        "react-doctor/no-collapse-request-error-to-empty-state": "error",
        "react-doctor/no-fetch-in-effect": "error",
        "react-doctor/no-adjust-state-on-prop-change": "error",
        "react-doctor/no-reset-all-state-on-prop-change": "error",
        "react-doctor/no-event-trigger-state": "error",
        "react-doctor/no-effect-event-handler": "error",
        "react-doctor/no-effect-chain": "error",
        "react-doctor/no-mirror-prop-effect": "error",
        "react-doctor/no-prop-callback-in-effect": "error",
        "react-doctor/no-pass-live-state-to-parent": "error",
        "react-doctor/no-self-updating-effect": "error",
        "react-doctor/no-set-state-after-await-in-effect": "error",
        "react-doctor/no-chain-state-updates": "error",
        "react-doctor/no-effect-with-fresh-deps": "error",
        "react-doctor/prefer-use-effect-event": "error",
        "react-doctor/prefer-use-sync-external-store": "error",
        "hinacode/no-manual-memo": "error",
        "hinacode/no-promise-state-in-effect": "error",
        "hinacode/prefer-start-transition": "warn"
      }
    },
    {
      "files": ["src/main/**", "src/preload/**", "src/shared/**"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    },
    {
      "files": ["src/renderer/components/ui/**"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["src/**/*.test.ts", "src/**/fakeAppServer.mjs", "e2e/**"],
      "rules": {
        "hinacode/no-wall-clock-in-test": "error"
      }
    }
  ],
  "ignorePatterns": ["out/**", "src/renderer/paraglide/**", "e2e/.features-gen/**", "apps/mobile/**"]
}
