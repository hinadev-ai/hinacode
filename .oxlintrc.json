{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-perf", "jsx-a11y", "import", "unicorn"],
  "jsPlugins": [
    {
      "name": "react-doctor",
      "specifier": "oxlint-plugin-react-doctor"
    },
    {
      "name": "hinacode",
      "specifier": "oxlint-plugin-hinacode"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "typescript/no-explicit-any": "error",
    "no-underscore-dangle": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/renderer/**"],
      "rules": {
        "react/refs": "error",
        "react/purity": "error",
        "react/immutability": "error",
        "react/set-state-in-effect": "error",
        "react/set-state-in-render": "error",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/void-use-memo": "error",
        "react/preserve-manual-memoization": "error",
        "react/incompatible-library": "error",
        "react/globals": "error",
        "react/unsupported-syntax": "error",
        "react/error-boundaries": "error",
        "react/hooks": "error",
        "react/exhaustive-effect-dependencies": "error",
        "react-doctor/no-async-effect-callback": "error",
        "react-doctor/effect-listener-cleanup-mismatch": "error",
        "react-doctor/effect-observer-needs-disconnect": "error",
        "react-doctor/effect-raf-loop-needs-cancel": "error",
        "react-doctor/no-derived-state": "error",
        "react-doctor/no-derived-state-effect": "error",
        "react-doctor/no-did-mount-set-state": "error",
        "react-doctor/no-cascading-set-state": "error",
        "react-doctor/no-direct-mutation-state": "error",
        "react-doctor/no-controlled-input-value-without-state-update": "error",
        "react-doctor/no-collapse-request-error-to-empty-state": "error"
      }
    },
    {
      "files": ["src/main/**", "src/preload/**", "src/shared/**"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    },
    {
      "files": ["src/renderer/components/ui/**"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["src/**/*.test.ts", "src/**/fakeAppServer.mjs", "e2e/**"],
      "rules": {
        "hinacode/no-wall-clock-in-test": "error"
      }
    }
  ],
  "ignorePatterns": ["out/**", "src/renderer/paraglide/**", "e2e/.features-gen/**", "apps/mobile/**"]
}
