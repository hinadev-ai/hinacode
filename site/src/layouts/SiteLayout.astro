---
import "../styles/global.css"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import { locales, localizedPath, messages, type Locale, type Page } from "../i18n"
interface Props {
  title: string
  description: string
  page: Page
  locale: Locale
}
const { title, description, page, locale } = Astro.props
const t = messages(locale)
const cjkFont =
  locale === "zh-TW"
    ? "&family=Noto+Sans+TC:wght@400..700"
    : locale === "ja"
      ? "&family=Noto+Sans+JP:wght@400..700"
      : ""
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" href="/favicon.svg" />
    {Astro.site && <link rel="canonical" href={new URL(localizedPath(locale, page), Astro.site)} />}
    {Astro.site &&
      locales.map((language) => (
        <link rel="alternate" hreflang={language} href={new URL(localizedPath(language, page), Astro.site)} />
      ))}
    {Astro.site && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath("en", page), Astro.site)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&family=Instrument+Serif:ital@1${cjkFont}&display=swap`}
    />
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js")
    </script>
  </head>
  <body>
    <a class="skip" href="#content">
      {t.site_skip}
    </a>
    <Nav page={page} locale={locale} />
    <div class="frame" id="top">
      <main id="content">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
    <script src="../scripts/platform.ts"></script>
  </body>
</html>
