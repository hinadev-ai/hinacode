---
import "@fontsource-variable/archivo/wdth.css"
import "@fontsource-variable/archivo/wdth-italic.css"
import "@fontsource-variable/martian-mono/wdth.css"
import "@fontsource-variable/noto-sans-jp"
import "@fontsource-variable/noto-sans-tc"
import "../styles/global.css"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import { locales, localizedPath, messages, type Locale, type Page } from "../i18n"
interface Props {
  title: string
  description: string
  page: Page
  locale: Locale
}
const { title, description, page, locale } = Astro.props
const t = messages(locale)
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ecedea" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {Astro.site && <link rel="canonical" href={new URL(localizedPath(locale, page), Astro.site)} />}
    {Astro.site &&
      locales.map((language) => (
        <link rel="alternate" hreflang={language} href={new URL(localizedPath(language, page), Astro.site)} />
      ))}
    {Astro.site && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath("en", page), Astro.site)} />}
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js")
    </script>
  </head>
  <body>
    <a class="skip" href="#content">
      {t.site_skip}
    </a>
    <Nav page={page} locale={locale} />
    <main id="content">
      <slot />
    </main>
    <Footer locale={locale} />
    <script src="../scripts/platform.ts"></script>
  </body>
</html>
