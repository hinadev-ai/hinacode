---
import { messages, type Locale } from "../i18n"
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = messages(locale)
---

<a class="btn btn-primary" href="https://github.com/hinadev-ai/hinacode/releases/latest" data-download>
  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path
      d="M8 2.5v8m0 0L4.75 7.25M8 10.5l3.25-3.25M3 13.5h10"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span data-download-label data-linux-label={t.site_download_linux}>
    {t.site_download_macos}
  </span>
</a>
