---
import { messages, type Locale } from "../i18n"
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = messages(locale)
---

<a class="download" href="https://github.com/hinadev-ai/hinacode/releases/latest" data-download>
  <span aria-hidden="true">[</span>
  <span class="download-arrow" aria-hidden="true">↓</span>
  <span data-download-label data-linux-label={t.site_download_linux}>
    {t.site_download_macos}
  </span>
  <span aria-hidden="true">]</span>
</a>
