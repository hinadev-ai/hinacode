---
import { RiGithubFill } from "react-icons/ri"
import { translator, type Locale } from "../i18n.ts"
import { REPO_URL } from "../links.ts"

interface Props {
  locale: Locale
}

const t = translator(Astro.props.locale)
---

<a
  href={REPO_URL}
  class="pressable inline-flex h-11 items-center gap-2 rounded-full bg-paper ps-4 pe-5 text-[15px] font-medium text-ink shadow-[0_0_0_1px_var(--color-line-strong),0_1px_2px_oklch(0_0_0/0.04)] hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2"
>
  <RiGithubFill aria-hidden="true" className="size-[1.125rem]" />
  {t("site_view_github")}
</a>
