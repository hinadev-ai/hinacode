---
import { RiClaudeFill, RiMetaFill, RiOpenaiFill } from "react-icons/ri"
import { MagpieLogoIcon, OpencodeLogoIcon } from "../icons.ts"
import { translator, type Locale } from "../i18n.ts"
import { RELEASES_URL } from "../links.ts"
import AgentField from "./AgentField.astro"
import CopyCommand from "./CopyCommand.astro"
import Download from "./Download.astro"
import GithubButton from "./GithubButton.astro"
import Mark from "./Mark.astro"
import Screen from "./Screen.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = translator(locale)

const providers = [
  { Icon: RiClaudeFill, name: t("provider_claude"), color: "text-[#d97757]" },
  { Icon: RiOpenaiFill, name: t("provider_codex"), color: "text-paper" },
  { Icon: RiMetaFill, name: t("provider_muse"), color: "text-[#0081fb]" },
  { Icon: OpencodeLogoIcon, name: t("provider_opencode"), color: "text-paper" },
  { Icon: MagpieLogoIcon, name: t("provider_magpie"), color: "text-paper" },
]
---

<section class="relative isolate">
  <div class="absolute inset-x-0 top-0 bottom-[22%] -z-10 overflow-hidden bg-ink sm:bottom-[30%]">
    <AgentField class="field-mask absolute inset-0 size-full" />
  </div>

  <div class="mx-auto max-w-[76rem] px-5 pt-16 text-center text-paper sm:px-8 sm:pt-28">
    <span class="mx-auto grid size-16 place-items-center rounded-2xl bg-paper shadow-[0_8px_24px_oklch(0_0_0/0.3)] sm:size-20 sm:rounded-3xl">
      <Mark tone="ink" class="size-10 sm:size-12" />
    </span>
    <h1 class="display mt-5 display-3 leading-none font-semibold">HinaCode</h1>
    <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
      <a
        href={RELEASES_URL}
        class="pressable inline-flex rounded-full bg-paper/10 px-3 py-1 font-mono text-xs text-paper/80 ring-1 ring-paper/15 hover:bg-paper/15 hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        {t("site_alpha")}
      </a>
      <span class="inline-flex rounded-full bg-paper/10 px-3 py-1 font-mono text-xs text-paper/60 ring-1 ring-paper/15">
        {t("site_backed_by")} <span class="ms-1 font-semibold text-paper">Kalan</span>
      </span>
    </div>
    <p class="display mt-8 display-1 leading-[1.05] font-semibold">
      <span class="block">{t("site_hero_title_1")}</span>
      <span class="block text-paper/60">{t("site_hero_title_2")}</span>
    </p>
    <p class="mx-auto mt-7 max-w-[38rem] text-lg leading-relaxed text-paper/75">{t("site_hero_lede")}</p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <Download locale={locale} />
      <GithubButton locale={locale} />
    </div>
    <CopyCommand locale={locale} command="npx hinacode serve" class="mt-5" />
    <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-paper/70">
      {
        providers.map(({ Icon, name, color }) => (
          <li class="flex items-center gap-2 font-mono text-[13px]">
            <Icon aria-hidden="true" className={`size-4 shrink-0 ${color}`} />
            {name}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mx-auto max-w-[78rem] px-3 pt-14 sm:px-8 sm:pt-18">
    <Screen
      src="/screens/approval.webp"
      alt={t("site_hero_shot_alt")}
      width={2432}
      height={1520}
      loading="eager"
      class="ring-1 ring-paper/10"
    />
  </div>
</section>
