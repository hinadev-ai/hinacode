---
import Demo from "../demo/Demo.tsx"
import { demoKeys } from "../demo/copy.ts"
import { pick, translator, type Locale } from "../i18n.ts"
import { RELEASES_URL } from "../links.ts"
import Download from "./Download.astro"
import GithubButton from "./GithubButton.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = translator(locale)
---

<section class="mx-auto max-w-[76rem] px-5 pt-12 sm:px-8 sm:pt-20">
  <a
    href={RELEASES_URL}
    class="pressable inline-flex max-w-full items-center gap-2.5 rounded-full bg-surface py-1 ps-1 pe-3.5 text-[13px] text-ink-soft shadow-[0_0_0_1px_var(--color-line)] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    <span class="shrink-0 rounded-full bg-ink px-2 py-0.5 text-xs font-semibold text-paper">{t("site_alpha")}</span>
    <span class="truncate">{t("site_alpha_note")}</span>
  </a>
  <h1 class="display mt-6 display-1 leading-[1.02] font-semibold">
    <span class="block">{t("site_hero_title_1")}</span>
    <span class="block text-ink-soft">{t("site_hero_title_2")}</span>
  </h1>
  <p class="mt-6 max-w-[40rem] text-lg leading-relaxed text-ink-soft sm:text-[1.1875rem]">{t("site_hero_lede")}</p>
  <div class="mt-8 flex flex-wrap items-center gap-3">
    <Download locale={locale} />
    <GithubButton locale={locale} />
  </div>
  <p class="mt-4 text-sm text-ink-soft">{t("site_hero_meta")}</p>
</section>

<section id="demo" aria-label={t("site_demo_label")} class="mx-auto max-w-[80rem] px-3 pt-14 sm:px-8 sm:pt-16">
  <p class="mx-2 mb-4 flex max-w-[44rem] items-start gap-2.5 text-sm text-ink-soft sm:mx-0">
    <span aria-hidden="true" class="mt-[0.4rem] size-2 shrink-0 rounded-full bg-coral"></span>
    {t("site_demo_hint")}
  </p>
  <Demo client:load copy={pick(locale, demoKeys)} locale={locale} />
</section>
