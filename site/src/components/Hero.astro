---
import { translator, type Locale } from "../i18n.ts"
import { RELEASES_URL } from "../links.ts"
import Download from "./Download.astro"
import GithubButton from "./GithubButton.astro"
import Screen from "./Screen.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = translator(locale)
---

<section class="mx-auto max-w-[76rem] px-5 pt-12 sm:px-8 sm:pt-20">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_25rem] lg:items-end lg:gap-16">
    <div>
      <a
        href={RELEASES_URL}
        class="pressable inline-flex rounded-full bg-ink px-2.5 py-0.5 text-xs font-semibold text-paper hover:bg-ink-soft focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        {t("site_alpha")}
      </a>
      <h1 class="display mt-6 display-1 leading-[1.02] font-semibold">
        <span class="block">{t("site_hero_title_1")}</span>
        <span class="block text-ink-soft">{t("site_hero_title_2")}</span>
      </h1>
    </div>
    <div class="lg:pb-2">
      <p class="text-lg leading-relaxed text-ink-soft">{t("site_hero_lede")}</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <Download locale={locale} />
        <GithubButton locale={locale} />
      </div>
    </div>
  </div>
  <Screen
    src="/screens/approval.webp"
    alt={t("site_hero_shot_alt")}
    width={2432}
    height={1520}
    loading="eager"
    class="mt-14 sm:mt-18"
  />
</section>
