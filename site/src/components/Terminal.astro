---
interface Props {
  title: string
  class?: string
}

const { title, class: className } = Astro.props
---

<figure class:list={["min-w-0 overflow-hidden rounded-xl bg-night text-paper ring-1 ring-paper/10", className]}>
  <div class="flex h-9 items-center gap-1.5 border-b border-paper/10 px-4">
    <span class="size-2.5 rounded-full bg-paper/20"></span>
    <span class="size-2.5 rounded-full bg-paper/20"></span>
    <span class="size-2.5 rounded-full bg-paper/20"></span>
    <span class="ms-3 truncate font-mono text-xs text-paper/70">{title}</span>
  </div>
  <slot />
</figure>
