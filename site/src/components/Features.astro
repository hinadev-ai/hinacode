---
import { FileDiffIcon, GlobeIcon, GuideIcon, TerminalIcon } from "../icons.ts"
import { translator, type Locale, type StringKey } from "../i18n.ts"
import Screen from "./Screen.astro"

interface Props {
  locale: Locale
}

const t = translator(Astro.props.locale)
const key = (value: string) => value as StringKey

const steps = [
  { id: "start", items: 4 },
  { id: "watch", items: 5 },
  { id: "steer", items: 4 },
  { id: "review", items: 4 },
  { id: "ship", items: 4 },
] as const
const reviewIcons = [FileDiffIcon, GuideIcon, GlobeIcon, TerminalIcon]
---

<section id="features" class="mx-auto max-w-[76rem] px-5 pt-28 sm:px-8 sm:pt-40">
  <h2 class="display max-w-[18ch] display-2 leading-[1.06] font-semibold">{t("site_features_title")}</h2>

  <div class="relative mt-16 lg:mt-20">
    <div aria-hidden="true" class="absolute inset-x-0 top-[5px] hidden h-px bg-line-strong lg:block"></div>
    <div aria-hidden="true" class="absolute inset-x-0 top-0 hidden overflow-hidden motion-reduce:hidden lg:block">
      <div class="rail-marker w-full">
        <span class="block size-[11px] -translate-x-1/2 bg-coral"></span>
      </div>
    </div>
    <ol class="relative grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-5">
    {
      steps.map(({ id: step, items }, index) => (
        <li>
          <div aria-hidden="true" class="flex items-center gap-3">
            <span class:list={["size-[11px] shrink-0 border-[1.5px]", step === "steer" ? "border-coral bg-coral" : "border-ink bg-paper"]} />
            <span class="h-px flex-1 bg-line-strong lg:hidden" />
          </div>
          <p class="mt-5 font-mono text-xs text-ink-soft">
            <span class="tabular-nums">{index}:</span>{t(key(`site_loop_${step}`)).toLowerCase()}
          </p>
          <h3 class="mt-3 text-[1.3125rem] leading-snug font-semibold tracking-[-0.01em] lg:min-h-[5.25rem]">
            {t(key(`site_loop_${step}_heading`))}
          </h3>
          <ul class="mt-4 space-y-2.5 text-[15px] text-ink-soft">
            {Array.from({ length: items }, (_, item) => item + 1).map((item) => <li>{t(key(`site_loop_${step}_${item}_title`))}</li>)}
          </ul>
        </li>
      ))
    }
    </ol>
  </div>
</section>

<section class="mx-auto max-w-[76rem] px-5 pt-28 sm:px-8 sm:pt-36">
  <div class="grid items-center gap-12 lg:grid-cols-[25rem_minmax(0,1fr)] lg:gap-20">
    <div>
      <h2 class="display display-3 leading-[1.08] font-semibold">{t("site_loop_review_heading")}</h2>
      <ul class="mt-9 border-b border-line">
        {
          reviewIcons.map((Icon, index) => (
            <li class="flex gap-4 border-t border-line py-[1.125rem]">
              <Icon aria-hidden="true" className="mt-0.5 size-5 shrink-0 text-ink [--sun:var(--color-coral)]" />
              <div>
                <h3 class="font-semibold">{t(key(`site_loop_review_${index + 1}_title`))}</h3>
                <p class="mt-1 text-[15px] leading-relaxed text-ink-soft">{t(key(`site_loop_review_${index + 1}_body`))}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <Screen src="/screens/review.webp" alt={t("site_review_shot_alt")} width={1232} height={1200} />
  </div>
</section>
