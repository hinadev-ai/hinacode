---
import type { IconComponent } from "../../../src/renderer/components/icons/Icon.tsx"
import {
  AtIcon,
  BellIcon,
  BoltIcon,
  BranchIcon,
  ChatIcon,
  CheckIcon,
  CodeIcon,
  EyeIcon,
  FileDiffIcon,
  GlobeIcon,
  GuideIcon,
  LinkIcon,
  PulseIcon,
  QuestionIcon,
  RobotIcon,
  ShieldIcon,
  SnoozeIcon,
  StackIcon,
  SteerIcon,
  TerminalIcon,
} from "../icons.ts"
import { demoKeys } from "../demo/copy.ts"
import { pick, translator, type Locale, type StringKey } from "../i18n.ts"
import Vignette from "./Vignette.tsx"

interface Props {
  locale: Locale
}

const t = translator(Astro.props.locale)
const copy = pick(Astro.props.locale, demoKeys)

const groups = [
  { id: "start" as const, icons: [BranchIcon, StackIcon, BoltIcon, AtIcon] },
  { id: "watch" as const, icons: [EyeIcon, SnoozeIcon, RobotIcon, BellIcon] },
  { id: "steer" as const, icons: [ShieldIcon, QuestionIcon, SteerIcon, ChatIcon] },
  { id: "review" as const, icons: [FileDiffIcon, GuideIcon, GlobeIcon, TerminalIcon] },
  { id: "ship" as const, icons: [LinkIcon, PulseIcon, CheckIcon, CodeIcon] },
] satisfies { id: string; icons: IconComponent[] }[]

const key = (value: string) => value as StringKey
---

<section id="features" class="mx-auto max-w-[76rem] px-5 pt-28 sm:px-8 sm:pt-40">
  <h2 class="display max-w-[20ch] display-2 leading-[1.06] font-semibold">
    {t("site_features_title")}
  </h2>
  <p class="mt-5 max-w-[42rem] text-lg leading-relaxed text-ink-soft">{t("site_features_lede")}</p>

  <div class="mt-16">
    {
      groups.map(({ id, icons }, index) => (
        <section class="grid gap-8 border-t border-line py-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,9fr)] lg:gap-16 lg:py-14">
          <div>
            <p class="flex items-center gap-2.5 text-sm font-medium text-ink-soft">
              <span class="font-mono text-xs tabular-nums">0{index + 1}</span>
              <span aria-hidden="true" class="h-px w-5 bg-line-strong" />
              {t(key(`site_loop_${id}`))}
            </p>
            <h3 class="display mt-3 text-[1.625rem] leading-tight font-semibold">{t(key(`site_loop_${id}_heading`))}</h3>
            <div class="mt-8 hidden lg:block">
              <Vignette id={id} copy={copy} />
            </div>
          </div>
          <ul class="grid gap-x-12 gap-y-9 sm:grid-cols-2">
            {icons.map((Icon, item) => (
              <li>
                <Icon aria-hidden="true" className="size-5 text-ink [--sun:var(--color-coral)]" />
                <h4 class="mt-3 text-base font-semibold">{t(key(`site_loop_${id}_${item + 1}_title`))}</h4>
                <p class="mt-1.5 text-[15px] leading-relaxed text-ink-soft">{t(key(`site_loop_${id}_${item + 1}_body`))}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</section>
