---
import Mark from "./Mark.astro"
import { messages, localizedPath, type Locale } from "../i18n"
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = messages(locale)
---

<footer class="footer">
  <span class="footer-credit">
    <Mark class="mark" />
    {t.site_footer_credit}
  </span>
  <nav aria-label={t.site_footer_nav}>
    <a href="https://github.com/hinadev-ai/hinacode">GitHub</a>
    <a href={localizedPath(locale, "pricing")}>{t.site_pricing}</a>
    <a href="https://github.com/hinadev-ai/hinacode/releases">{t.site_releases}</a>
    <a href="#top">{t.site_back_top}</a>
  </nav>
</footer>
