---
import { languageNames, localizedPath, locales, translator, type Locale, type Page } from "../i18n.ts"
import { REPO_URL } from "../links.ts"
import Mark from "./Mark.astro"

interface Props {
  locale: Locale
  page: Page
}

const { locale, page } = Astro.props
const t = translator(locale)
const home = localizedPath(locale, "home")
const link = "rounded text-paper/70 hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2"
const sections = [
  { id: "features", label: t("site_nav_features") },
  { id: "tools", label: t("site_nav_tools") },
  { id: "remote", label: t("site_nav_remote") },
  { id: "faq", label: t("site_nav_faq") },
]
---

<footer class="border-t border-paper/10 bg-ink text-paper">
  <div class="mx-auto grid max-w-[76rem] gap-10 px-5 py-14 sm:px-8 md:grid-cols-[minmax(0,1fr)_auto]">
    <div>
      <a href={home} class="inline-flex items-center gap-2 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4">
        <Mark tone="paper" class="size-5" />
        <span class="text-sm font-semibold">HinaCode</span>
      </a>
      <p class="mt-3 max-w-[22rem] text-sm text-paper/70">{t("site_footer_tagline")}</p>
      <p class="mt-1 text-sm text-paper/70">{t("site_footer_license")}</p>
    </div>
    <div class="flex flex-wrap gap-x-14 gap-y-8 text-sm">
      <ul class="space-y-2.5">
        <li><a href={`${home}#features`} class={link}>{t("site_nav_features")}</a></li>
        <li><a href={localizedPath(locale, "pricing")} class={link}>{t("site_nav_pricing")}</a></li>
      </ul>
      <ul class="space-y-2.5">
        <li><a href={REPO_URL} class={link}>{t("site_nav_github")}</a></li>
        <li><a href={`${REPO_URL}/releases`} class={link}>{t("site_footer_releases")}</a></li>
      </ul>
      <ul class="space-y-2.5" aria-label={t("site_nav_language")}>
        {
          locales.map((option) => (
            <li>
              <a
                href={localizedPath(option, page)}
                hreflang={option}
                lang={option}
                aria-current={option === locale ? "page" : undefined}
                class:list={[link, "aria-[current=page]:text-paper aria-[current=page]:font-medium"]}
              >
                {languageNames[option]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <nav aria-label={t("site_nav_sections")} class="border-t border-paper/10 bg-night font-mono text-xs">
    <div class="mx-auto flex h-8 max-w-[76rem] items-center gap-4 overflow-x-auto px-5 whitespace-nowrap sm:px-8">
      <span class="bg-coral px-1.5 text-night">hinacode</span>
      {
        sections.map(({ id, label }, index) => (
          <a href={`${home}#${id}`} class={link}>
            {index}:{label.toLowerCase()}
          </a>
        ))
      }
      <span class="ms-auto text-paper/70">main · MIT</span>
    </div>
  </nav>
</footer>
