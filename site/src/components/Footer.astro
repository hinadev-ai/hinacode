---
import { languageNames, localizedPath, locales, translator, type Locale, type Page } from "../i18n.ts"
import { REPO_URL } from "../links.ts"
import Mark from "./Mark.astro"

interface Props {
  locale: Locale
  page: Page
}

const { locale, page } = Astro.props
const t = translator(locale)
const home = localizedPath(locale, "home")
const link = "rounded text-ink-soft hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2"
---

<footer class="border-t border-line">
  <div class="mx-auto grid max-w-[76rem] gap-10 px-5 py-14 sm:px-8 md:grid-cols-[minmax(0,1fr)_auto]">
    <div>
      <a href={home} class="inline-flex items-center gap-2 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4">
        <Mark class="size-5" />
        <span class="text-sm font-semibold">HinaCode</span>
      </a>
      <p class="mt-3 max-w-[22rem] text-sm text-ink-soft">{t("site_footer_tagline")}</p>
      <p class="mt-1 text-sm text-ink-soft">{t("site_footer_license")}</p>
    </div>
    <div class="flex flex-wrap gap-x-14 gap-y-8 text-sm">
      <ul class="space-y-2.5">
        <li><a href={`${home}#features`} class={link}>{t("site_nav_features")}</a></li>
        <li><a href={localizedPath(locale, "pricing")} class={link}>{t("site_nav_pricing")}</a></li>
      </ul>
      <ul class="space-y-2.5">
        <li><a href={REPO_URL} class={link}>{t("site_nav_github")}</a></li>
        <li><a href={`${REPO_URL}/releases`} class={link}>{t("site_footer_releases")}</a></li>
      </ul>
      <ul class="space-y-2.5" aria-label={t("site_nav_language")}>
        {
          locales.map((option) => (
            <li>
              <a
                href={localizedPath(option, page)}
                hreflang={option}
                lang={option}
                aria-current={option === locale ? "page" : undefined}
                class:list={[link, "aria-[current=page]:text-ink aria-[current=page]:font-medium"]}
              >
                {languageNames[option]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
