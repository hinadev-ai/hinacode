---
import { BellIcon, ChatsIcon, ComputerIcon, ForkIcon, KeyIcon, LayoutIcon, LinearIcon, PhoneIcon } from "../icons.ts"
import { translator, type Locale } from "../i18n.ts"

interface Props {
  locale: Locale
}

const t = translator(Astro.props.locale)

const highlights = [
  { Icon: LayoutIcon, title: t("site_tools_artifacts_title"), body: t("site_tools_artifacts_body") },
  { Icon: ComputerIcon, title: t("site_tools_vm_title"), body: t("site_tools_vm_body") },
]

const tools = [
  { Icon: KeyIcon, names: ["request_secret"], body: t("site_tools_secret") },
  { Icon: ForkIcon, names: ["create_thread", "run_agent"], body: t("site_tools_threads") },
  { Icon: BellIcon, names: ["watch_pull_request"], body: t("site_tools_watch") },
  { Icon: ChatsIcon, names: ["read_thread"], body: t("site_tools_read") },
  { Icon: PhoneIcon, names: ["device_screenshot", "device_tap"], body: t("site_tools_devices") },
  { Icon: LinearIcon, names: ["linear_create_comment"], body: t("site_tools_linear") },
]
---

<section id="tools" class="mt-28 bg-ink text-paper sm:mt-40">
  <div class="mx-auto max-w-[76rem] px-5 py-24 sm:px-8 sm:py-32">
    <h2 class="display display-3 leading-[1.08] font-semibold">{t("site_tools_title")}</h2>

    <div class="mt-14 grid gap-12 border-t border-paper/15 pt-12 md:grid-cols-2 md:gap-16">
      {
        highlights.map(({ Icon, title, body }) => (
          <div>
            <Icon aria-hidden="true" className="size-6 [--sun:var(--color-coral)]" />
            <h3 class="mt-5 text-[1.375rem] font-semibold tracking-[-0.01em]">{title}</h3>
            <p class="mt-3 max-w-[32rem] text-base leading-relaxed text-paper/75">{body}</p>
          </div>
        ))
      }
    </div>

    <dl class="mt-16 border-b border-paper/15">
      {
        tools.map(({ Icon, names, body }) => (
          <div class="grid gap-2 border-t border-paper/15 py-5 sm:grid-cols-[17rem_minmax(0,1fr)] sm:gap-8 lg:grid-cols-[25rem_minmax(0,1fr)] lg:gap-20">
            <dt class="flex items-start gap-3 font-mono text-[13px] leading-6">
              <Icon aria-hidden="true" className="mt-[3px] size-[1.125rem] shrink-0 [--sun:var(--color-coral)]" />
              <span class="min-w-0 break-words">
                {names.map((name) => (
                  <span class="block">{name}</span>
                ))}
              </span>
            </dt>
            <dd class="text-[15px] leading-relaxed text-paper/75 sm:pt-px">{body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
