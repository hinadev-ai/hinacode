---
import { CheckIcon, TranslateIcon } from "../icons.ts"
import { languageNames, localizedPath, locales, translator, type Locale, type Page } from "../i18n.ts"

interface Props {
  locale: Locale
  page: Page
}

const { locale, page } = Astro.props
const t = translator(locale)
---

<details data-menu class="group relative">
  <summary
    aria-label={t("site_nav_language")}
    class="pressable flex h-8 cursor-pointer list-none items-center gap-1.5 rounded-full px-2.5 text-[13px] font-medium text-ink-soft select-none hover:bg-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 group-open:bg-muted group-open:text-ink [&::-webkit-details-marker]:hidden"
  >
    <TranslateIcon aria-hidden="true" className="size-4" />
    <span class="hidden sm:inline">{languageNames[locale]}</span>
  </summary>
  <ul
    class="absolute end-0 top-full z-50 mt-2 min-w-40 rounded-xl bg-paper p-1 shadow-[0_0_0_1px_oklch(0_0_0/0.07),0_8px_24px_-6px_oklch(0.32_0.026_196/0.18)]"
  >
    {
      locales.map((option) => (
        <li>
          <a
            href={localizedPath(option, page)}
            hreflang={option}
            lang={option}
            aria-current={option === locale ? "page" : undefined}
            class="pressable flex h-8 items-center justify-between gap-3 rounded-lg px-2.5 text-[13px] text-ink hover:bg-muted focus-visible:outline-2 focus-visible:-outline-offset-2"
          >
            {languageNames[option]}
            {option === locale && <CheckIcon aria-hidden="true" className="size-3.5 text-teal" />}
          </a>
        </li>
      ))
    }
  </ul>
</details>
