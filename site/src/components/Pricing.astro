---
import { RiClaudeFill, RiMetaFill, RiOpenaiFill } from "react-icons/ri"
import Layout from "../layouts/Layout.astro"
import { CheckIcon } from "../icons.ts"
import { translator, type Locale, type StringKey } from "../i18n.ts"
import Download from "./Download.astro"
import Faq from "./Faq.astro"
import GithubButton from "./GithubButton.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = translator(locale)
const included = [1, 2, 3, 4, 5, 6, 7, 8].map((index) => t(`site_pricing_item_${index}` as StringKey))
const agents = [
  { Icon: RiClaudeFill, name: t("provider_claude"), color: "text-provider-claude" },
  { Icon: RiOpenaiFill, name: t("provider_codex"), color: "text-ink" },
  { Icon: RiMetaFill, name: t("provider_muse"), color: "text-provider-muse" },
]
---

<Layout
  locale={locale}
  page="pricing"
  title={t("site_pricing_meta_title")}
  description={t("site_pricing_meta_description")}
>
  <section class="mx-auto max-w-[76rem] px-5 pt-14 sm:px-8 sm:pt-24">
    <h1 class="display display-1 leading-[1.03] font-semibold">{t("site_pricing_title")}</h1>
    <p class="mt-6 max-w-[38rem] text-lg leading-relaxed text-ink-soft">{t("site_pricing_lede")}</p>
  </section>

  <section class="mx-auto mt-14 grid max-w-[76rem] gap-6 px-5 sm:px-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
    <div class="rounded-3xl bg-paper p-7 shadow-window sm:p-10">
      <p class="text-sm font-semibold text-ink-soft">{t("site_pricing_plan")}</p>
      <p class="mt-3 font-mono text-[4.25rem] leading-none font-semibold tracking-[-0.04em]">
        {t("site_pricing_price")}
      </p>
      <p class="mt-3 text-ink-soft">{t("site_pricing_note")}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Download locale={locale} />
        <GithubButton locale={locale} />
      </div>
      <h2 class="mt-10 border-t border-line pt-8 text-sm font-semibold">{t("site_pricing_includes")}</h2>
      <ul class="mt-5 grid gap-x-8 gap-y-3.5 sm:grid-cols-2">
        {
          included.map((item) => (
            <li class="flex items-start gap-2.5 text-[15px] leading-snug">
              <CheckIcon aria-hidden="true" className="mt-0.5 size-4 shrink-0 text-teal" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="self-start rounded-3xl bg-surface p-7 sm:p-10">
      <h2 class="display text-2xl font-semibold">{t("site_pricing_costs_title")}</h2>
      <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">{t("site_pricing_costs_body")}</p>
      <ul class="mt-8 space-y-4">
        {
          agents.map(({ Icon, name, color }) => (
            <li class="flex items-center gap-3 font-medium">
              <Icon aria-hidden="true" className={`size-5 ${color}`} />
              {name}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq locale={locale} />
  <div class="pb-28 sm:pb-40"></div>
</Layout>
