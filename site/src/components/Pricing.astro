---
import SiteLayout from "../layouts/SiteLayout.astro"
import Download from "./Download.astro"
import Closing from "./Closing.astro"
import Mark from "./Mark.astro"
import Text from "./Text.astro"
import { messages, type Locale } from "../i18n"
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = messages(locale)
---

<SiteLayout title={t.site_pricing_title} description={t.site_pricing_description} page="pricing" locale={locale}>
  <div class="pricing-hero">
    <p class="eyebrow rise" style="--i: 0">
      {t.site_pricing}
    </p>
    <h1 class="rise" style="--i: 1">
      <Text text={t.site_pricing_heading}>
        <span slot="all" class="taste">
          {t.site_pricing_all}
        </span>
      </Text>
    </h1>
    <p class="lede rise" style="--i: 2">
      {t.site_pricing_lede}
    </p>
  </div>

  <div class="pricing">
    <div class="plan rise" style="--i: 3">
      <div class="plan-head">
        <span>{t.site_plan_everything}</span>
        <span class="plan-badge">{t.site_plan_only}</span>
      </div>
      <div class="price">
        <b>$0</b>
        <span>{t.site_plan_forever}</span>
      </div>
      <p class="plan-note">{t.site_plan_note}</p>
      <Download locale={locale} />
      <ul class="included" aria-label={t.site_included}>
        <li data-state="done">
          <span class="status" aria-hidden="true"></span>
          {t.site_included_unlimited}
        </li>
        <li data-state="done">
          <span class="status" aria-hidden="true"></span>
          {t.site_agents}
        </li>
        <li data-state="done">
          <span class="status" aria-hidden="true"></span>
          {t.site_feature_worktree_title}
        </li>
        <li data-state="done">
          <span class="status" aria-hidden="true"></span>
          {t.site_included_approvals}
        </li>
        <li data-state="done">
          <span class="status" aria-hidden="true"></span>
          {t.site_included_steer}
        </li>
        <li data-state="done">
          <span class="status" aria-hidden="true"></span>
          {t.site_included_mcp}
        </li>
        <li data-state="done">
          <span class="status" aria-hidden="true"></span>
          {t.site_included_pr}
        </li>
        <li data-state="done">
          <span class="status" aria-hidden="true"></span>
          {t.site_included_ports}
        </li>
        <li data-state="done">
          <span class="status" aria-hidden="true"></span>
          {t.site_included_automations}
        </li>
        <li data-state="done">
          <span class="status" aria-hidden="true"></span>
          {t.site_included_shortcuts}
        </li>
      </ul>
    </div>

    <figure class="receipt" aria-label={t.site_receipt_label}>
      <header>
        <Mark />
        <b>HINACODE</b>
        {t.site_receipt_number}
      </header>
      <dl>
        <div>
          <dt>{t.site_threads}</dt>
          <dd>{t.site_receipt_unlimited}</dd>
        </div>
        <div>
          <dt>{t.site_receipt_worktrees}</dt>
          <dd>{t.site_receipt_unlimited}</dd>
        </div>
        <div>
          <dt>{t.site_receipt_agents}</dt>
          <dd>2 · $0.00</dd>
        </div>
        <div>
          <dt>{t.site_receipt_approvals}</dt>
          <dd>{t.site_receipt_any}</dd>
        </div>
        <div>
          <dt>{t.site_receipt_pr}</dt>
          <dd>{t.site_receipt_all}</dd>
        </div>
        <div>
          <dt>{t.site_receipt_taste}</dt>
          <dd>{t.site_receipt_included}</dd>
        </div>
        <div>
          <dt>{t.site_receipt_focus}</dt>
          <dd>{t.site_receipt_included}</dd>
        </div>
      </dl>
      <div class="total">
        <span>{t.site_receipt_total}</span>
        <span>$0.00</span>
      </div>
      <footer>
        {t.site_receipt_paid}
        <br />
        {t.site_receipt_thanks}
      </footer>
    </figure>
  </div>

  <section class="rule">
    <p class="eyebrow">{t.site_costs_eyebrow}</p>
    <h2>
      <Text text={t.site_costs_heading}>
        <em slot="agents">{t.site_costs_agents}</em>
      </Text>
    </h2>
    <p class="section-lede">
      <Text text={t.site_costs_description}>
        <code slot="claude">claude</code>
        <code slot="codex">codex</code>
      </Text>
    </p>
    <div class="costs">
      <div>
        <b>HinaCode</b>
        <p>{t.site_costs_hinacode}</p>
      </div>
      <div>
        <b>{t.site_agents}</b>
        <p>{t.site_costs_plans}</p>
      </div>
    </div>
  </section>

  <Closing locale={locale} />
</SiteLayout>
