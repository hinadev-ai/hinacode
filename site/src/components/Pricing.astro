---
import SiteLayout from "../layouts/SiteLayout.astro"
import Download from "./Download.astro"
import Closing from "./Closing.astro"
import Text from "./Text.astro"
import { messages, type Locale } from "../i18n"
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = messages(locale)

const items = [
  [t.site_threads, t.site_receipt_unlimited],
  [t.site_receipt_worktrees, t.site_receipt_unlimited],
  [t.site_receipt_agents, "2 · $0.00"],
  [t.site_receipt_approvals, t.site_receipt_any],
  [t.site_receipt_pr, t.site_receipt_all],
  [t.site_receipt_taste, t.site_receipt_included],
  [t.site_receipt_focus, t.site_receipt_included],
]
---

<SiteLayout title={t.site_pricing_title} description={t.site_pricing_description} page="pricing" locale={locale}>
  <section class="title-screen" aria-labelledby="headline">
    <div class="frame">
      <div class="title-columns">
        <div class="offer">
          <h1 id="headline" class="pricing-headline">
            <Text text={t.site_pricing_heading}>
              <span slot="all" class="focus">{t.site_pricing_all}</span>
            </Text>
          </h1>
          <p class="lede">{t.site_pricing_lede}</p>
          <div class="ctas">
            <Download locale={locale} />
          </div>
          <p class="fineprint">
            {t.site_plan_note}
            <br />
            {t.site_experimental}
          </p>
        </div>

        <figure class="board rates" aria-label={t.site_receipt_label}>
          <p class="panel-title">{t.site_receipt_number}</p>
          <dl>
            {
              items.map(([name, value]) => (
                <div>
                  <dt>{name}</dt>
                  <dd>{value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="rates-total">
            <span>{t.site_receipt_total}</span>
            <span>$0.00</span>
          </p>
          <p class="rates-paid">{t.site_receipt_paid}</p>
          <p class="fineprint">{t.site_receipt_thanks}</p>
        </figure>
      </div>
    </div>
  </section>

  <section class="field field-brown" aria-labelledby="costs-heading">
    <div class="field-inner">
      <h2 id="costs-heading">
        <Text text={t.site_costs_heading}>
          <span slot="agents" class="focus">{t.site_costs_agents}</span>
        </Text>
      </h2>
      <p class="section-lede">
        <Text text={t.site_costs_description}>
          <code slot="claude">claude</code>
          <code slot="codex">codex</code>
        </Text>
      </p>
      <dl class="menu">
        <div>
          <dt>
            <span class="menu-title">HinaCode</span>
            <code>$0.00</code>
          </dt>
          <dd>{t.site_costs_hinacode}</dd>
        </div>
        <div>
          <dt>
            <span class="menu-title">{t.site_agents}</span>
            <code>{t.site_costs_your_plan}</code>
          </dt>
          <dd>{t.site_costs_plans}</dd>
        </div>
      </dl>
    </div>
  </section>

  <Closing locale={locale} />
</SiteLayout>
