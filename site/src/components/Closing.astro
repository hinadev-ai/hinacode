---
import Download from "./Download.astro"
import Skyline from "./Skyline.astro"
import { messages, type Locale } from "../i18n"
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = messages(locale)
---

<section class="field field-magenta closing" aria-labelledby="closing-heading">
  <div class="field-inner">
    <h2 id="closing-heading">
      {t.site_closing_lead}
      <br />
      <span>{t.site_closing_emphasis}</span>
    </h2>
    <p class="section-lede">{t.site_closing_description}</p>
    <div class="ctas">
      <Download locale={locale} />
      <a class="link" href="https://github.com/hinadev-ai/hinacode">
        {t.site_view_github}
      </a>
    </div>
  </div>
  <Skyline class="skyline-closing" />
</section>
