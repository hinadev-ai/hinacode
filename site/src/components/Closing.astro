---
import Download from "./Download.astro"
import { messages, type Locale } from "../i18n"
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = messages(locale)
---

<section class="rule closing">
  <h2>
    {t.site_closing_lead}
    <br />
    <em>{t.site_closing_emphasis}</em>
  </h2>
  <p class="section-lede">{t.site_closing_description}</p>
  <div class="ctas">
    <Download locale={locale} />
    <a class="btn" href="https://github.com/hinadev-ai/hinacode">
      {t.site_view_github}
    </a>
  </div>
</section>
