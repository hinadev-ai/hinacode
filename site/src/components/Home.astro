---
import SiteLayout from "../layouts/SiteLayout.astro"
import Text from "./Text.astro"
import DemoTemplates from "./DemoTemplates.astro"
import Download from "./Download.astro"
import Closing from "./Closing.astro"
import { messages, localizedPath, type Locale } from "../i18n"
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = messages(locale)
---

<SiteLayout title={t.site_home_title} description={t.site_home_description} page="home" locale={locale}>
  <div class="hero">
    <span class="backed rise" tabindex="0" style="--i: 0">
      {t.site_backed_by}{" "}
      <span class="logo" aria-hidden="true">
        K
      </span>
      <b>Kalan</b>
      <span class="backed-tip" role="tooltip">
        {t.site_backed_tooltip}
      </span>
    </span>

    <h1 class="rise" style="--i: 1">
      <Text text={t.site_home_headline}>
        <span slot="taste" class="taste">
          {t.site_taste}
        </span>
        <span slot="focus" class="focus">
          {t.site_focus}
        </span>
      </Text>
    </h1>

    <p class="lede rise" style="--i: 2">
      {t.site_home_lede}
    </p>

    <div class="ctas rise" style="--i: 3">
      <Download locale={locale} />
      <a class="btn" href="#demo">
        {t.site_see_demo}
      </a>
    </div>
    <p class="fineprint rise" style="--i: 4">
      <Text text={t.site_platforms}>
        <code slot="claude">claude</code>
        <code slot="codex">codex</code>
      </Text>
    </p>
  </div>

  <div class="stage rise" id="demo" style="--i: 5">
    <div class="window" role="region" aria-label={t.site_demo_label}>
      <div class="titlebar" aria-hidden="true">
        <div class="lights">
          <i></i>
          <i></i>
          <i></i>
        </div>
        <div class="titlebar-title">KKCode</div>
      </div>

      <aside class="side" aria-label={t.site_threads}>
        <div class="side-label">{t.site_projects}</div>
        <div class="project">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M2 4.5c0-.83.67-1.5 1.5-1.5h3l1.5 1.5h4.5c.83 0 1.5.67 1.5 1.5v5.5c0 .83-.67 1.5-1.5 1.5h-9c-.83 0-1.5-.67-1.5-1.5v-7Z"
              stroke="currentColor"
              stroke-width="1.2"
            />
          </svg>
          acme-web
        </div>
        <ul class="threads">
          <li class="thread active" data-thread="main" data-state="working">
            <span class="status" role="img" aria-label={t.site_state_working}></span>
            <span class="thread-title">{t.site_demo_address_title}</span>
            <span class="thread-meta">
              <span class="thread-time">{t.site_now}</span>
              <span class="tag-needs">{t.site_state_needs}</span>
            </span>
            <span class="thread-branch">feat/address-validation</span>
          </li>
          <li class="thread" data-state="working">
            <span class="status" role="img" aria-label={t.site_state_working}></span>
            <span class="thread-title">{t.site_demo_checkout_title}</span>
            <span class="thread-meta">{t.site_demo_time_checkout}</span>
            <span class="thread-branch">fix/checkout-e2e</span>
          </li>
          <li class="thread" data-state="done">
            <span class="status" role="img" aria-label={t.site_state_done}></span>
            <span class="thread-title">{t.site_demo_webhook_title}</span>
            <span class="thread-meta">{t.site_demo_time_webhook}</span>
            <span class="thread-branch">fix/webhook-retry</span>
          </li>
        </ul>
        <div class="project">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M2 4.5c0-.83.67-1.5 1.5-1.5h3l1.5 1.5h4.5c.83 0 1.5.67 1.5 1.5v5.5c0 .83-.67 1.5-1.5 1.5h-9c-.83 0-1.5-.67-1.5-1.5v-7Z"
              stroke="currentColor"
              stroke-width="1.2"
            />
          </svg>
          KKCode
        </div>
        <ul class="threads">
          <li class="thread" data-state="working">
            <span class="status" role="img" aria-label={t.site_state_working}></span>
            <span class="thread-title">{t.site_demo_panel_title}</span>
            <span class="thread-meta">{t.site_demo_time_panel}</span>
            <span class="thread-branch">feat/resizable-side-panel</span>
          </li>
          <li class="thread" data-state="failed">
            <span class="status" role="img" aria-label={t.site_state_failed}></span>
            <span class="thread-title">{t.site_demo_setup_title}</span>
            <span class="thread-meta">{t.site_demo_time_setup}</span>
            <span class="thread-branch">fix/loading-flash</span>
          </li>
          <li class="thread" data-state="done">
            <span class="status" role="img" aria-label={t.site_state_done}></span>
            <span class="thread-title">{t.site_demo_catalog_title}</span>
            <span class="thread-meta">{t.site_demo_time_catalog}</span>
            <span class="thread-branch">feat/zh-tw</span>
          </li>
        </ul>
      </aside>

      <div class="main">
        <div class="main-head">
          <b>{t.site_demo_address_title}</b>
          <span class="chip mono">feat/address-validation</span>
          <span
            class="chip"
            data-chip
            data-state="working"
            data-label-working={t.site_state_working}
            data-label-needs={t.site_state_needs}
            data-label-done={t.site_state_done}
          >
            <span class="status" aria-hidden="true"></span>
            <span data-chip-label>{t.site_state_working}</span>
          </span>
        </div>

        <div class="transcript" data-transcript aria-live="polite">
          <div class="msg-user">{t.site_demo_prompt}</div>
          <div class="msg-agent step" data-stream>
            {t.site_demo_response}
          </div>
          <div class="tool step">
            <span class="glyph" aria-hidden="true">
              →
            </span>
            {t.site_read}
            <span class="path">src/checkout/validators.ts</span>
          </div>
          <div class="tool step">
            <span class="glyph" aria-hidden="true">
              ✎
            </span>
            {t.site_edit}
            <span class="path">validators.ts</span>
            <span class="add">+8</span>
            <span class="del">−3</span>
          </div>
          <div class="tool step">
            <span class="glyph" aria-hidden="true">
              $
            </span>
            pnpm test validators
            <span class="ok">{t.site_demo_tests}</span>
          </div>
          <div class="approval step" data-approval>
            <div class="approval-head" data-state="needs">
              <span class="status" aria-hidden="true"></span>
              <span data-approval-title data-label-allowed={t.site_demo_allowed} data-label-denied={t.site_demo_denied}>
                {t.site_demo_command_request}
              </span>
            </div>
            <code>git push -u origin feat/address-validation</code>
            <div class="approval-actions">
              <button class="btn" type="button" data-deny>
                {t.site_deny}
                <kbd>D</kbd>
              </button>
              <button class="btn btn-primary" type="button" data-allow>
                {t.site_allow}
                <kbd>A</kbd>
              </button>
            </div>
          </div>
        </div>

        <form class="composer" data-composer autocomplete="off">
          <label class="sr-only" for="steer">
            {t.site_steer_label}
          </label>
          <input id="steer" maxlength="120" placeholder={t.site_steer_placeholder} />
          <div class="composer-bar" aria-hidden="true">
            <span>Claude Code</span>
            <span>Opus 5.5</span>
            <span>{t.site_worktree}</span>
            <span class="send">↑</span>
          </div>
        </form>
      </div>

      <aside class="panel" aria-label={t.site_thread_details}>
        <div>
          <h3>{t.site_changes}</h3>
          <ul class="files">
            <li>
              <span class="name">validators.ts</span>
              <span class="m">M</span>
              <span class="add">+8</span>
              <span class="del">−3</span>
            </li>
            <li>
              <span class="name">validators.test.ts</span>
              <span class="a">A</span>
              <span class="add">+42</span>
            </li>
            <li>
              <span class="name">AddressForm.tsx</span>
              <span class="m">M</span>
              <span class="add">+2</span>
              <span class="del">−1</span>
            </li>
          </ul>
        </div>
        <div>
          <h3>{t.site_ports}</h3>
          <div class="port">
            <span>:3000</span>
            <span>next dev</span>
            <span class="kill">{t.site_stop}</span>
          </div>
        </div>
        <div>
          <h3>{t.site_pull_request}</h3>
          <div data-pr-slot>
            <p class="pr-empty" data-pr-empty>
              {t.site_no_pr}
            </p>
          </div>
        </div>
      </aside>
    </div>

    <p class="stage-hint" data-hint aria-live="polite">
      <span>{t.site_demo_hint_idle}</span>
    </p>
  </div>

  <section class="rule" id="quiet" style="margin-top: 120px">
    <div class="split">
      <div>
        <p class="eyebrow">{t.site_quiet_eyebrow}</p>
        <h2>
          <Text text={t.site_quiet_heading}>
            <em slot="matters">{t.site_matters}</em>
          </Text>
        </h2>
        <p class="section-lede">{t.site_quiet_description}</p>
      </div>
      <ul class="legend">
        <li data-state="working">
          <span class="status" aria-hidden="true"></span>
          <b>{t.site_state_working}</b>
          <p>{t.site_legend_working}</p>
        </li>
        <li data-state="needs">
          <span class="status" aria-hidden="true"></span>
          <b>{t.site_state_needs}</b>
          <p>{t.site_legend_needs}</p>
        </li>
        <li data-state="failed">
          <span class="status" aria-hidden="true"></span>
          <b>{t.site_state_failed}</b>
          <p>{t.site_legend_failed}</p>
        </li>
        <li data-state="done">
          <span class="status" aria-hidden="true"></span>
          <b>{t.site_state_done}</b>
          <p>{t.site_legend_done}</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="rule" id="features">
    <div class="split">
      <div>
        <p class="eyebrow">{t.site_features_eyebrow}</p>
        <h2>{t.site_features_heading}</h2>
      </div>
      <p class="section-lede split-aside">{t.site_features_description}</p>
    </div>
    <div class="grid">
      <article class="cell">
        <h3>{t.site_feature_worktree_title}</h3>
        <p>
          <Text text={t.site_feature_worktree_description}>
            <code slot="env">.env</code>
          </Text>
        </p>
        <code>$KKCODE_WORKTREE_PATH</code>
      </article>
      <article class="cell">
        <h3>{t.site_feature_approvals_title}</h3>
        <p>{t.site_feature_approvals_description}</p>
        <code>{t.site_allow_session}</code>
      </article>
      <article class="cell">
        <h3>{t.site_feature_steer_title}</h3>
        <p>{t.site_feature_steer_description}</p>
        <code>threads.steer</code>
      </article>
      <article class="cell">
        <h3>{t.site_feature_mcp_title}</h3>
        <p>{t.site_feature_mcp_description}</p>
        <code>review_changes</code>
      </article>
      <article class="cell">
        <h3>{t.site_feature_pr_title}</h3>
        <p>{t.site_feature_pr_description}</p>
        <code>gh pr create --fill</code>
      </article>
      <article class="cell">
        <h3>{t.site_feature_ports_title}</h3>
        <p>{t.site_feature_ports_description}</p>
        <code>:3000 next dev</code>
      </article>
      <article class="cell">
        <h3>{t.site_feature_automations_title}</h3>
        <p>{t.site_feature_automations_description}</p>
        <code>{"{{issue.title}}"}</code>
      </article>
      <article class="cell">
        <h3>{t.site_feature_setup_title}</h3>
        <p>{t.site_feature_setup_description}</p>
        <code>AGENTS.md</code>
      </article>
    </div>
  </section>

  <section class="rule" id="keyboard">
    <div class="split">
      <div>
        <p class="eyebrow">{t.site_keyboard_eyebrow}</p>
        <h2>
          <Text text={t.site_keyboard_heading}>
            <em slot="home">{t.site_keyboard_home}</em>
          </Text>
        </h2>
        <p class="section-lede">{t.site_keyboard_description}</p>
      </div>
      <div>
        <ul class="keys" data-keys>
          <li>
            <span>{t.site_key_new_thread}</span>
            <span>
              <kbd data-key="mod">⌘</kbd>
              <kbd data-key="n">N</kbd>
            </span>
          </li>
          <li>
            <span>{t.site_key_next_thread}</span>
            <span>
              <kbd data-key="mod">⌘</kbd>
              <kbd data-key="shift">⇧</kbd>
              <kbd data-key="]">]</kbd>
            </span>
          </li>
          <li>
            <span>{t.site_key_composer}</span>
            <span>
              <kbd data-key="mod">⌘</kbd>
              <kbd data-key="l">L</kbd>
            </span>
          </li>
          <li>
            <span>{t.site_key_interrupt}</span>
            <span>
              <kbd data-key="mod">⌘</kbd>
              <kbd data-key="shift">⇧</kbd>
              <kbd data-key="c">C</kbd>
            </span>
          </li>
          <li>
            <span>{t.site_key_changes}</span>
            <span>
              <kbd data-key="mod">⌘</kbd>
              <kbd data-key="shift">⇧</kbd>
              <kbd data-key="d">D</kbd>
            </span>
          </li>
          <li>
            <span>{t.site_key_terminal}</span>
            <span>
              <kbd data-key="mod">⌘</kbd>
              <kbd data-key="j">J</kbd>
            </span>
          </li>
        </ul>
        <p class="keys-note">{t.site_keyboard_note}</p>
      </div>
    </div>
  </section>

  <section class="rule" id="simple">
    <p class="eyebrow">{t.site_simple_eyebrow}</p>
    <h2>
      <Text text={t.site_simple_heading}>
        <em slot="kkcode">KKCode</em>
      </Text>
    </h2>
    <p class="section-lede">{t.site_simple_description}</p>
    <div class="numbers">
      <div>
        <b>1</b>
        <span>{t.site_number_sqlite}</span>
      </div>
      <div>
        <b>1</b>
        <span>{t.site_number_channel}</span>
      </div>
      <div>
        <b>1</b>
        <span>{t.site_number_provider}</span>
      </div>
      <div>
        <b>0</b>
        <span>{t.site_number_daemons}</span>
      </div>
    </div>
  </section>

  <section class="rule" id="faq">
    <div class="split">
      <div>
        <p class="eyebrow">{t.site_faq_eyebrow}</p>
        <h2>{t.site_faq_heading}</h2>
      </div>
      <div class="faq">
        <details>
          <summary>{t.site_faq_what_question}</summary>
          <p>{t.site_faq_what_answer}</p>
        </details>
        <details>
          <summary>{t.site_faq_agents_question}</summary>
          <p>{t.site_faq_agents_answer}</p>
        </details>
        <details>
          <summary>{t.site_faq_keys_question}</summary>
          <p>
            <Text text={t.site_faq_keys_answer}>
              <code slot="claude">claude</code>
              <code slot="codex">codex</code>
            </Text>
          </p>
        </details>
        <details>
          <summary>{t.site_faq_code_question}</summary>
          <p>{t.site_faq_code_answer}</p>
        </details>
        <details>
          <summary>{t.site_faq_editor_question}</summary>
          <p>{t.site_faq_editor_answer}</p>
        </details>
        <details>
          <summary>{t.site_faq_price_question}</summary>
          <p>
            <Text text={t.site_faq_price_answer}>
              <a slot="pricing" class="inline" href={localizedPath(locale, "pricing")}>
                {t.site_see_pricing}
              </a>
            </Text>
          </p>
        </details>
        <details>
          <summary>{t.site_faq_platforms_question}</summary>
          <p>{t.site_faq_platforms_answer}</p>
        </details>
      </div>
    </div>
  </section>

  <Closing locale={locale} />
  <DemoTemplates locale={locale} />
</SiteLayout>
<script src="../scripts/demo.ts"></script>
