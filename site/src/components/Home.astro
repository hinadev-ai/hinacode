---
import Layout from "../layouts/Layout.astro"
import { translator, type Locale } from "../i18n.ts"
import Agents from "./Agents.astro"
import Cta from "./Cta.astro"
import Faq from "./Faq.astro"
import Features from "./Features.astro"
import Hero from "./Hero.astro"
import Remote from "./Remote.astro"
import Tools from "./Tools.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = translator(locale)
---

<Layout locale={locale} page="home" title={t("site_meta_title")} description={t("site_meta_description")}>
  <Hero locale={locale} />
  <Features locale={locale} />
  <Tools locale={locale} />
  <Remote locale={locale} />
  <Agents locale={locale} />
  <Faq locale={locale} />
  <Cta locale={locale} />
</Layout>
