---
import "@fontsource-variable/noto-sans-tc/index.css"
import "@fontsource-variable/noto-sans-jp/index.css"
import Home from "../../components/Home.astro"
import { localeFromParam, localePaths } from "../../i18n.ts"

export function getStaticPaths() {
  return [{ params: { language: localePaths["zh-TW"] } }, { params: { language: localePaths.ja } }]
}

const locale = localeFromParam(Astro.params.language)
---

<Home locale={locale} />
