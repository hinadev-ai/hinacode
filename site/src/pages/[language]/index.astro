---
import Home from "../../components/Home.astro"
import { locales, localePaths, type Locale } from "../../i18n"

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== "en")
    .map((locale) => ({
      params: { language: localePaths[locale] },
      props: { locale },
    }))
}

interface Props {
  locale: Locale
}
const { locale } = Astro.props
---

<Home locale={locale} />
