{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "moduleDetection": "force"
  },
  "include": [
    "scripts/**/*.ts",
    "packages/*/src/**/*.ts",
    ".agents/skills/*/scripts/*.ts",
    "apps/mobile/scripts/*.mts",
    "src/preload/index.d.ts"
  ]
}
