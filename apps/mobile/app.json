{
  "expo": {
    "name": "HinaCode",
    "slug": "hinacode",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hinacode",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "ZY99H6ZA58",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "HinaCode connects to your desktop directly when both are on the same network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f7f2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hinadev.hinacode"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f7f2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100,
          "dark": {
            "backgroundColor": "#1c2e2e"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "HinaCode uses the camera to scan the pairing QR code shown in desktop Settings.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HinaCode attaches the photos you pick to your message.",
          "cameraPermission": "HinaCode uses the camera to scan the pairing QR code shown in desktop Settings.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-localization",
      "./plugins/compact-tab-bar.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
