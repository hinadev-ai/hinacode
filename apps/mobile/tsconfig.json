{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "lib": ["DOM", "ES2022"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../../src/shared/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
