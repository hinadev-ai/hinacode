import { writeFileSync } from "node:fs"
import { build } from "esbuild"

const { outputFiles } = await build({
  entryPoints: [new URL("../src/vm-screen/page-entry.ts", import.meta.url).pathname],
  bundle: true,
  minify: true,
  format: "esm",
  target: "safari16",
  write: false,
  legalComments: "eof",
})
const script = outputFiles[0]!.text.replaceAll("</script", "<\\/script")

const page = `<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<style>
html, body, #screen { margin: 0; height: 100%; width: 100%; overflow: hidden; background: transparent; }
#screen { touch-action: none; }
</style>
</head>
<body>
<div id="screen"></div>
<script type="module">${script}</script>
</body>
</html>
`
const out = new URL("../src/vm-screen/vm-screen-page.ts", import.meta.url)
writeFileSync(
  out,
  `// oxlint-disable-next-line hinacode/no-comments\n// Generated by scripts/build-vm-screen-html.mts from @novnc/novnc and src/vm-screen. Run \`pnpm build:vm-screen\` after changing either.\nexport const VM_SCREEN_HTML = ${JSON.stringify(page)}\n`,
)
