      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the desktop, open Settings, Remote, and turn on Allow remote control. Scan the QR code it shows, or paste the pairing URL. A cloud prints its QR code when you run hinacode serve, or hinacode pair later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップで設定のリモート接続を開き、リモート操作を許可をオンにします。表示された QR コードを読み取るか、ペアリング URL を貼り付けてください。クラウドは hinacode serve の実行時、または後から hinacode pair で QR コードを表示します。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在桌面版開啟設定的遠端，並開啟允許遠端控制。掃描它顯示的 QR 碼，或貼上配對網址。雲端會在執行 hinacode serve 時印出 QR 碼，之後也可以用 hinacode pair 再次印出。"
          }
