{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowJs": true,
    "paths": { "@/*": ["./src/renderer/*"] }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/preload/*.d.ts", "site/app/**/*", "packages/icons/src/**/*"],
  "exclude": [
    "src/renderer/**/*.test.ts",
    "src/renderer/**/*.test.tsx",
    "packages/icons/src/*.native.tsx",
    "packages/icons/src/*.web.tsx"
  ]
}
