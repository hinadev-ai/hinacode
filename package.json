    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.4",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-shimmer": "^0.4.13",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "optionalDependencies": {
    "node-mac-permissions": "github:codebytere/node-mac-permissions#7bdd039cc5bb0dd9c81540df4340b0c4bdb3be37"
