{
  "name": "kkcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/node-pty-spawn-helper.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "release": "electron-vite build && electron-builder --mac --publish always",
    "start:xvfb": "DISPLAY=:99 electron-vite preview -- --no-sandbox --disable-gpu --remote-debugging-port=9222",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/renderer/paraglide --strategy globalVariable baseLocale --silent",
    "typecheck": "pnpm paraglide && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.web-test.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint",
    "check:specs": "node scripts/tlc.mjs",
    "format": "oxfmt",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "bddgen -c e2e/playwright.config.ts && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@effect/platform-node": "4.0.3",
    "@effect/sql-sqlite-node": "4.0.3",
    "@linear/sdk": "97.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@muse-code/sdk": "1.4.7",
    "effect": "4.0.3",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@effect/atom-react": "4.0.3",
    "@effect/language-service": "0.87.4",
    "@effect/vitest": "4.0.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@formkit/auto-animate": "0.10.0",
    "@inlang/paraglide-js": "2.27.0",
    "@legendapp/list": "3.6.0",
    "@novnc/novnc": "1.7.0",
    "@pierre/diffs": "1.5.2",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-hotkeys": "0.13.0",
    "@tanstack/react-router": "1.170.42",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "@wterm/dom": "0.5.4",
    "@wterm/ghostty": "0.5.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "fuzzysort": "4.0.2",
    "mermaid": "12.1.0",
    "node-gyp": "12.2.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-plugin-react-doctor": "0.9.17",
    "playwright-bdd": "9.2.1",
    "react": "19.3.0",
