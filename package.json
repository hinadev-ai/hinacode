{
  "name": "hinacode",
  "version": "0.1.0-alpha.4",
  "private": true,
  "description": "Run coding agents on this machine and drive them from the HinaCode desktop or phone app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hinadev-ai/hinacode.git"
  },
  "bin": {
    "hinacode": "bin/hinacode.mjs"
  },
  "files": [
    "bin",
    "out/server"
  ],
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-app-identity.ts && node scripts/build-resource-monitor.ts && electron-vite dev",
    "dev:markdown": "HINACODE_MOCK_CLAUDE=markdown HINACODE_USER_DATA=/tmp/kk-markdown pnpm dev",
    "dev:overview": "node scripts/overview-mock/seed.ts /tmp/kk-overview && HINACODE_MOCK_CLAUDE=subagents HINACODE_USER_DATA=/tmp/kk-overview pnpm dev",
    "dev:remote": "node scripts/remote-devtools.ts",
    "build": "electron-vite build",
    "build:server": "vite build --config vite.server.config.ts --ssr src/main/daemon.ts --outDir out/server",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --publish never",
    "start:xvfb": "DISPLAY=:99 electron-vite preview -- --no-sandbox --disable-gpu --remote-debugging-port=9222",
    "serve": "vite build --config vite.server.config.ts --ssr src/main/daemon.ts --outDir out/server && node out/server/daemon.js serve",
    "stage:server": "node scripts/stage-server-package.ts",
    "verify:server": "node scripts/verify-server-package.ts",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/renderer/paraglide --strategy globalVariable baseLocale --silent",
    "typecheck": "pnpm paraglide && tsrs --noEmit -p tsconfig.node.json && tsrs --noEmit -p tsconfig.web.json && tsrs --noEmit -p tsconfig.web-test.json && tsrs --noEmit -p tsconfig.e2e.json && tsrs --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint",
    "check:specs": "node scripts/tlc.ts",
    "chart:thread": "node scripts/thread-chart.ts",
    "resource-monitor": "tools/resource-monitor/bin/resource-monitor",
    "format": "oxfmt",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "bddgen -c e2e/playwright.config.ts && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@effect/platform-node": "4.0.3",
    "@effect/sql-sqlite-node": "4.0.3",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@linear/sdk": "97.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@muse-code/sdk": "1.4.13",
    "@noble/hashes": "2.4.0",
    "effect": "4.0.3",
    "electron-updater": "6.8.9",
    "node-pty": "1.2.0-beta.15",
    "playwright-core": "1.64.0",
    "qrcode": "^1.5.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@effect/atom-react": "4.0.3",
    "@effect/language-service": "0.87.4",
    "@effect/vitest": "4.0.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@formkit/auto-animate": "0.10.0",
    "@inlang/paraglide-js": "2.27.0",
    "@legendapp/list": "3.6.0",
    "@novnc/novnc": "1.7.0",
    "@pierre/diffs": "1.5.2",
    "@playwright/test": "1.64.0",
    "@pulls.review/core": "0.3.4",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-hotkeys": "0.13.0",
    "@tanstack/react-router": "1.170.42",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "@wterm/dom": "0.5.4",
    "@wterm/ghostty": "0.5.4",
    "anser": "2.3.5",
    "babel-plugin-react-compiler": "1.0.0",
    "chrono-node": "2.10.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "fuzzysort": "4.0.2",
    "motion": "14.2.0",
    "node-gyp": "12.2.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-plugin-hinacode": "workspace:*",
    "oxlint-plugin-react-doctor": "0.9.17",
    "pele": "1.9.0",
    "playwright": "1.64.0",
    "playwright-bdd": "9.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.4",
    "size-limit": "14.3.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tw-shimmer": "^0.4.13",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1",
    "node-mac-permissions": "github:codebytere/node-mac-permissions#7bdd039cc5bb0dd9c81540df4340b0c4bdb3be37"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@12.10.1"
}
